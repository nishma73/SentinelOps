# SentinelOps Environment Configuration Example
# Copy this file to .env and customize values for your deployment.

# Environment mode: "development" or "production"
APP_ENV=development

# Debug mode: true/false (must be false in production)
DEBUG=false

# Model Mock Mode: true (runs deterministic simulation out of the box without API credits)
# Set to false and provide ANTHROPIC_API_KEY for live Anthropic Claude invocations
MOCK_MODE=true

# Anthropic Claude API Key (Required in production when MOCK_MODE=false)
ANTHROPIC_API_KEY=your_api_key_here

# MCP Bearer Authentication Token (Required in production)
MCP_AUTH_TOKEN=sentinelops-demo-auth-token-xyz

# Allowed CORS Origins (comma-separated; wildcard '*' forbidden in production)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Path to the pause trigger file
PAUSE_FILE_PATH=PAUSE

# Server Port
PORT=8000
